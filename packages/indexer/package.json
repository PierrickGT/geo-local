		"test": "vitest run"
	},
	"dependencies": {
		"@geo-local/shared": "workspace:*",
		"@geoprotocol/grc-20": "0.4.1",
		"pg": "8.20.0"
	},
	"devDependencies": {
		"@types/node": "22.19.13",
		"@types/pg": "8.18.0",
		"tsup": "8.5.1",
		"tsx": "4.21.0",
		"vitest": "3.2.4"
	}
}
