		"express": "5.2.1"
	},
	"devDependencies": {
		"@types/express": "5.0.6",
		"@types/node": "22.19.13",
		"@types/supertest": "7.2.0",
		"supertest": "7.2.2",
		"tsup": "8.5.1",
		"tsx": "4.21.0",
		"vitest": "4.1.2"
	}
}
